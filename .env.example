# Database
DATABASE_URL="postgresql://user:password@localhost:5432/devotional_store?schema=public"

# Authentication (Auth.js / NextAuth)
AUTH_SECRET="generate-a-long-random-string-here"
AUTH_URL="http://localhost:3000"

# Optional: Image storage (leave empty for local public/uploads)
# STORAGE_PROVIDER="local"
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional: Payment (Razorpay later)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Optional: AI Interpretation (future)
# AI_API_KEY=

# Payment provider: "mock" (default sandbox) or later "razorpay"
PAYMENT_PROVIDER="mock"
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Payment provider: "mock" (default, free) or "razorpay" (future)
PAYMENT_PROVIDER="mock"

# Razorpay (only needed when PAYMENT_PROVIDER=razorpay)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Astrology engine: "stub" (default) until Swiss Ephemeris is integrated
ASTROLOGY_ENGINE="stub"

# Public store branding (no secrets)
NEXT_PUBLIC_STORE_NAME="Devotional Store"
NEXT_PUBLIC_STORE_TAGLINE="Divine essentials for daily seva"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
# NEXT_PUBLIC_SUPPORT_PHONE=
